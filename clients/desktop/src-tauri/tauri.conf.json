{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nestune",
  "mainBinaryName": "Nestune",
  "version": "1.0.0",
  "identifier": "net.ouse.nestune.desktop",
  "build": {
    "frontendDist": "https://music.0use.net/"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nestune",
    "homepage": "https://music.0use.net/",
    "shortDescription": "Nestune 音乐客户端",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "Nestune",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
