{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nestune",
  "mainBinaryName": "Nestune",
  "version": "1.2.10",
  "identifier": "net.ouse.nestune.desktop",
  "build": {
    "frontendDist": "../overlay"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        "lyrics-main",
        "lyrics-local"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Nestune",
    "homepage": "https://nestune.0use.net:8443/",
    "shortDescription": "Nestune 音乐客户端",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Nestune",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    }
  }
}
