# Copy to .env.local and fill in. Never commit the real file.

# Unlocks /admin. At least 32 characters. There are no admin accounts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=

# audio-worker on the NAS (NCM decrypt / MP3 transcode). Optional.
WORKER_URL=http://192.168.1.80:4191
WORKER_KEY=

# Optional
# DATA_DIR=./data            # database, session, cache, library, avatars
# PUBLIC_ORIGINS=            # extra allowed Origins, comma separated (only needed behind a different public URL)
